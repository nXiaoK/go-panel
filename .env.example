# go-panel 部署配置示例。复制为 .env 后再填写真实值；.env 已被 Git 忽略，禁止提交密钥。

# 必填：至少 32 字节随机值。可执行 `openssl rand -hex 32` 生成；修改会使现有 JWT 全部失效。
JWT_SECRET=请替换为至少32字节随机密钥

# 新令牌有效期：Go duration 格式，默认 2160h（90天），范围 1h–2160h；非法值会启动失败。
# 缩短后用户需要更频繁地重新登录；已签发令牌仍按原 exp 到期，不会追溯缩短。
# 立即让全部令牌失效需轮换 JWT_SECRET，但也会导致现有加密 R2 凭据无法解密，须重新配置。
JWT_TTL=2160h

# 首次启动必填高强度密码；确认管理员已创建且完成密码轮换后，可清空此值再重建容器。
ADMIN_USERNAME=admin_user
ADMIN_PASSWORD=请替换为唯一的高强度密码

# 必填：浏览器访问面板时使用的完整来源，不带末尾斜杠；多个来源用逗号分隔。
CORS_ALLOW_ORIGIN=https://panel.example.com

# HTML 内容安全策略：默认 report-only 只在浏览器报告违规，首版观察一个版本后改为 enforce 才会拦截。
# 只允许 report-only、enforce、off，非法值拒绝启动；off 会失去 CSP 的脚本来源与嵌入等纵深防护。
# 违规报告发送到同源 /api/v1/csp-report（限流、脱敏后写入日志，搜索“CSP 违规报告”）；确认无违规后可显式切换 enforce。
# API、静态 JS/CSS 和订阅不发送此策略；生产面板只支持同源 API/WebSocket。
CSP_MODE=report-only

# 默认向所有宿主机接口开放 6365。使用本机反向代理时建议改为 127.0.0.1。
PANEL_BIND=0.0.0.0
PANEL_PORT=6365

# 默认拉取最新稳定版；固定 v0.1.0 等版本可获得可重复部署和明确回滚点，但会禁用跨版本一键更新。
GO_PANEL_VERSION=latest

# 仅配置真实反向代理的 CIDR；空值表示忽略 X-Forwarded-For 等请求头。
TRUSTED_PROXIES=

# 以下兼容开关默认关闭。开启 HTTP 下载或旧上报都会降低安全/一致性，升级节点后应立即恢复 false。
ALLOW_INSECURE_NODE_DOWNLOADS=false
ALLOW_LEGACY_NFT_REPORTS=false

# 稳定版更新检查默认开启并缓存 6 小时；关闭后界面仍会显示当前构建版本。
UPDATE_CHECK_ENABLED=true
UPDATE_REPOSITORY=nXiaoK/go-panel
UPDATE_CHECK_INTERVAL=6h

# 仅使用 compose.update.yml 时填写：执行 `openssl rand -hex 32` 生成，切勿复用 JWT_SECRET。
UPDATE_TRIGGER_TOKEN=

# 时区影响计划任务和日志时间，不影响数据库中保存的 Unix 时间戳。
TZ=Asia/Shanghai

# 仅本地 npm run dev 的 Vite 代理读取；默认转发到本机 6365，生产容器不使用。
# 并行开发可指向各自后端端口；不要指向不可信服务器，避免转发登录凭据。
# VITE_DEV_API_TARGET=http://127.0.0.1:6365
